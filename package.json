{
  "name": "citymeter-governmentoffice",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "CityMETER · Government Office — district-first 3D map of government offices and the personnel production records across Thailand, with the nearest public services round a site, recent moves and openings, and rail context from the same registry",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build:base": "python3 -I scripts/fetch-base.py --help",
    "build:boundaries": "python3 -I scripts/build-boundaries.py --help",
    "build:receipts": "python3 -I scripts/build-receipts.py --help",
    "build:data": "python3 -I scripts/build-data.py --help",
    "check:lds": "node scripts/check-lds-parity.mjs",
    "handoff:manifest": "node scripts/build-handoff.mjs",
    "handoff:bundle": "node scripts/build-handoff.mjs --zip dist/CityMETER-GovernmentOffice-Developer-Handoff.zip",
    "verify:live": "node scripts/verify-live.mjs",
    "build:units": "python3 -I scripts/adapt-building-units.py --help"
  }
}
